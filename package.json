{
  "name": "commonplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "format": "prettier --write src docs .github *.md *.json vite.config.ts",
    "format:check": "prettier --check src docs .github *.md *.json vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "prettier": "3.9.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "A curated open-source software library with thoughtful discovery, comparison and personal toolkits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saketh12e/commonplace.git"
  },
  "bugs": {
    "url": "https://github.com/saketh12e/commonplace/issues"
  },
  "homepage": "https://github.com/saketh12e/commonplace#readme"
}
